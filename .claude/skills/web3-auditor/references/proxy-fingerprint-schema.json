{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "proxy_fingerprint.py output (V3 Block 4, C1, docs/decisiones.md D-072)",
  "description": "Documentation reference only, not executed at runtime. Exact/near-fixed standard templates only, no severity field anywhere.",
  "type": "object",
  "required": ["proxyFingerprintVersion", "status", "cborMetadataStripped", "matches", "note"],
  "additionalProperties": false,
  "properties": {
    "proxyFingerprintVersion": {"type": "string"},
    "status": {"enum": ["matched", "no_match"]},
    "cborMetadataStripped": {"type": "boolean"},
    "note": {"type": "string"},
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern", "name", "implementation", "confidence", "note"],
        "additionalProperties": false,
        "properties": {
          "pattern": {"enum": ["EIP-1167", "EIP-1967"]},
          "name": {"type": "string"},
          "implementation": {"type": ["string", "null"], "description": "Only ever non-null for EIP-1167, where the address is literally embedded in bytecode."},
          "confidence": {"const": "low"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
