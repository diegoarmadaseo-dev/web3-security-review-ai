      "confidence": "high",
      "description": "withdraw() sends ETH via a low-level call before decrementing balances[msg.sender], with no reentrancy guard. A contract receiving the call can re-enter withdraw() from its receive/fallback before the balance is reduced and repeat the withdrawal, draining the contract.",
      "evidence": [
        "function withdraw(uint256 amount) external {",
        "    require(balances[msg.sender] >= amount, \"insufficient balance\");",
        "    (bool ok, ) = msg.sender.call{value: amount}(\"\");",
        "    require(ok, \"transfer failed\");",
        "    balances[msg.sender] -= amount;"
      ],
